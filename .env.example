# Public WooCommerce WordPress store used for the product catalogue, cart and checkout.
NEXT_PUBLIC_STORE_URL=https://farmeralot.co.za
# Use preview for the local presentation; switch to live after the host allows the Store API.
NEXT_PUBLIC_STOREFRONT_MODE=live

# Create a key at https://platform.openai.com/api-keys and keep it server-side.
OPENAI_API_KEY=

# Quote requests are emailed through Resend. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# One or more sales inboxes, separated by commas.
SALES_EMAIL_TO=eliseenweb@gmail.com
